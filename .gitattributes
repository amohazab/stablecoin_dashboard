# Line endings pinned so hashed bytes == committed bytes (P-3.02, P-3.05).
docs/context/*.md   text eol=lf
out/**/*.json       text eol=lf
# Root files whose byte counts the record states (P-4.02).
PROGRESS.md         text eol=lf
CLAUDE.md           text eol=lf
.gitignore          text eol=lf
# Files the gate chain hashes: DET-10(a) set file, DET-77 sheet mirror,
# the event log (P-4.03).
config/*.toml       text eol=lf
config/*.json       text eol=lf
out/logs/*.jsonl    text eol=lf
# Source, so `git add` stops warning on the files whose byte counts entries
# state (P-4.06; optional line, rides this hunk).
*.py                text eol=lf
.gitattributes      text eol=lf
