  <a href="{{ blob }}/{{ w.memo.sheet }}">intake sheet</a>
  <a href="{{ blob }}/docs/context/rubic_v1.md">rubric</a>
  <a href="{{ blob }}/PROGRESS.md">PROGRESS.md</a>
</nav>
</div>
{% endblock %}
